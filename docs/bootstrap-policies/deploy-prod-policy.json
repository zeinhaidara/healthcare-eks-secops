{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EKSDescribeCluster",
      "Effect": "Allow",
      "Action": "eks:DescribeCluster",
      "Resource": "arn:aws:eks:us-east-2:<ACCOUNT_ID>:cluster/cloudbatch818-zein-hcsecops"
    },
    {
      "Sid": "ECRDescribeImages",
      "Effect": "Allow",
      "Action": "ecr:DescribeImages",
      "Resource": "arn:aws:ecr:us-east-2:<ACCOUNT_ID>:repository/cloudbatch818-zein-hcsecops-healthcare-api"
    },
    {
      "Sid": "AcmFindCertificate",
      "Effect": "Allow",
      "Action": "acm:ListCertificates",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-2" } }
    }
  ]
}
